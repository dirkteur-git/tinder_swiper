# Supabase project — vul deze in .env.local
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Optioneel — alleen gebruikt voor magic-link redirect URL.
# In productie wordt dit automatisch afgeleid uit de request-host.
APP_URL=http://localhost:3000

# Whitelist voor magic-link login. Comma-separated emails OF domeinen.
# Lege string = alleen exact gemarkeerde emails uit ALLOWED_EMAILS hieronder.
# Default voorbeelden: dirk@vondr.ai, milan@vondr.ai, en alles op @vondr.ai.
NEXT_PUBLIC_ALLOWED_EMAILS=dirk@vondr.ai,milan@vondr.ai
NEXT_PUBLIC_ALLOWED_DOMAINS=vondr.ai
